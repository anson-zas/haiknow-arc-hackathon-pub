  "action_before_name_pattern": "\\b(?P<action>clicks?|opens?|chooses?|selects?|checks?|unchecks?|hovers?)\\s+(?:(?:on|over|the|a|an)\\s+){0,2}(?:(?:groups|group|searchboxes|checkboxes|comboboxes|textboxes|searchbox|articles|checkbox|combobox|buttons|textbox|dialogs|article|regions|button|fields|inputs|dialog|region|links|forms|field|input|link|form|对话框|按钮|链接|表单|字段)\\s+(?:(?:named|labeled|labelled|called)\\s*)?)?$",
  "negated_action_pattern": "(?:\\bnot|\\bnever|\\bwithout|\\bcannot|\\bcan't|\\bdon't|\\bdoesn't)\\s*$",
  "actions": {
    "click": "click",
    "clicks": "click",
    "open": "open",
    "opens": "open",
    "choose": "choose",
    "chooses": "choose",
    "select": "select",

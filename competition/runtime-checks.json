    "article": "article",
    "articles": "article",
    "region": "region",
    "regions": "region",
    "checkbox": "checkbox",
    "checkboxes": "checkbox",
    "combobox": "combobox",
    "comboboxes": "combobox",
    "searchbox": "searchbox",
    "searchboxes": "searchbox",
    "按钮": "button",
    "链接": "link",
    "表单": "form",
    "字段": "unknown",
    "对话框": "dialog",
    "group": "group",

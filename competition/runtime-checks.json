  "navigation_collapse_negative_pattern": "\\b(?:not|never|without|cannot)\\b[^.\\n]*(?:collapse|icon)|\\b(?:doesn.t|don.t|can.t)\\b[^.\\n]*(?:collapse|icon)",
  "container_role_negative_pattern": "\\b(?:not|never|without|cannot|can't|doesn't|don't)\\b|禁止|不得|不是|不能"
}
